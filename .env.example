# ── VolticPlayer local secrets / config ─────────────────────────────────────
# Loaded at runtime by flutter_dotenv. Do not commit real keys.

# YouTube Data API v3 (required for songs / movies / playlist search)
YOUTUBE_API_KEY=AIzaSyBof6fFBKWU8QWr-SFO7eoOZ0hq9JJQ6Lg

# Google Programmable Search (optional — Instagram / Facebook / Pictures / Google tabs)
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=

# Google Sign-In server client ID (Web OAuth client — required for the
# Google account picker on Profile / YouTube sign-in)
GOOGLE_SERVER_CLIENT_ID=982049966982-kg8t2vvi0q45bu05kgci6vcs9gbji7g1.apps.googleusercontent.com

# Google Sign-In iOS client ID (required on iOS, ignored on Android)
GOOGLE_IOS_CLIENT_ID=982049966982-459be36hq7jhissmuteli6fcrgdhl2to.apps.googleusercontent.com

# Downloader ceilings (optional overrides)
DOWNLOADER_MAX_CONCURRENT=6
DOWNLOADER_MAX_FILE_SIZE=524288000
DOWNLOADER_MAX_DURATION=3600
DOWNLOADER_ANALYZE_RATE_LIMIT=10
DOWNLOADER_DOWNLOAD_RATE_LIMIT=5
DOWNLOADER_TEMP_FILE_TTL=1800
DOWNLOADER_MAX_STORAGE=5368709120
